{
  "name": "@tequila99/githuman",
  "version": "0.1.0",
  "description": "Review AI agent code changes before commit — Vue edition",
  "homepage": "https://github.com/tequila99/githuman#readme",
  "bugs": {
    "url": "https://github.com/tequila99/githuman/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tequila99/githuman.git"
  },
  "bin": {
    "githuman": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "quasar dev",
    "dev:server": "node --watch-path=src src/cli/index.ts serve --no-open",
    "clean": "rm -rf dist",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "build:web": "quasar build",
    "start": "node dist/cli/index.js serve",
    "test": "npm run test:server && npm run test:cli && npm run test:web",
    "test:server": "node --test 'tests/server/**/*.test.ts'",
    "test:cli": "node --test 'tests/cli/**/*.test.ts'",
    "test:web": "node --import ./tests/web/register-web-alias-loader.mjs --test 'tests/web/**/*.test.ts'",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:web": "vue-tsc --noEmit",
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "postinstall": "node -e \"require('node:fs').existsSync('quasar.config.ts')&&require('node:child_process').execSync('quasar prepare --silent',{stdio:'inherit'})\"",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/one-line-logger": "^2.0.2",
    "@fastify/sse": "^0.4.0",
    "@fastify/static": "^8.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "diff": "^5.2.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "shiki": "^4.4.3",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@playwright/test": "^1.57.0",
    "@quasar/app-vite": "^3.8.1",
    "@quasar/extras": "^2.0.4",
    "@types/diff": "^5.2.0",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "pinia": "^4.0.2",
    "postcss": "^8.5.8",
    "quasar": "^2.30.1",
    "typescript": "^6.0.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "productName": "GitHuman"
}
